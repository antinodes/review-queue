# Copy to .env.local and fill in to enable GitHub OAuth sign-in.
# With NONE of these set, the app shows the personal-access-token (PAT) form —
# this is the zero-config default for `npm run dev` and self-hosters.

# OAuth App client id. Public value, baked into the build.
VITE_GITHUB_CLIENT_ID=

# Endpoint that exchanges the OAuth code for an access token.
# On the CDK stack in infra/ this is served same-origin, so use: /auth/exchange
VITE_TOKEN_EXCHANGE_URL=

# OAuth scope requested. Defaults to "repo" when unset.
# VITE_GITHUB_SCOPE=repo

# Set to "true" to keep the PAT form visible even when OAuth is configured.
# VITE_ENABLE_PAT=false
